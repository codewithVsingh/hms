{
  "name": "hms-phase-four",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:website": "pnpm --filter @hms/website dev",
    "dev:portal": "pnpm --filter @hms/portal dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:security": "node --experimental-strip-types --test tests/security-static.test.cjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.56.0"
  }
}
