{
  "name": "hms",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:website": "pnpm --filter @hms/website dev",
    "dev:portal": "pnpm --filter @hms/portal dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:contracts": "node --test tests/contracts.test.cjs",
    "test:security": "node --experimental-strip-types --test tests/security-static.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.74.0"
  }
}
