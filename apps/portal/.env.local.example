# Demo works without credentials; switch to false only on isolated staging first.
HMS_DEMO_MODE=true
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_HOSPITAL_NAME=
# Live connection: copy values from your own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HMS_ORGANIZATION_SLUG=
HMS_BRANCH_CODE=MAIN
# Approved policy; do not point to fictional placeholder policies.
HMS_NOTICE_VERSION=
HMS_NOTICE_URL=
# Configure Supabase Auth SMS and CAPTCHA with this Turnstile site key + server secret in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Razorpay TEST keys initially. Set HMS_RAZORPAY_MODE=live and HMS_ENABLE_REAL_PAYMENTS=true only after sign-off.
HMS_RAZORPAY_MODE=test
HMS_ENABLE_REAL_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Background worker (generate a random secret of at least 32 characters)
CRON_SECRET=
HMS_RECONCILIATION_ENABLED=false
# Channel sends require explicit patient opt-in, verified contacts and approved templates.
HMS_NOTIFY_EMAIL=false
RESEND_API_KEY=
HMS_FROM_EMAIL=
HMS_NOTIFY_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
HMS_NOTIFY_WHATSAPP=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
HMS_WA_LANGUAGE=en
# JSON mapping of event keys to approved Meta template names (no template parameters).
HMS_WA_TEMPLATE_MAP=
# Private scanner must be approved for healthcare documents and return {"clean":true}.
HMS_PRIVATE_SCANNER_URL=
HMS_PRIVATE_SCANNER_TOKEN=
# Public website callbacks; restrict allowed host in Turnstile console.
HMS_CALLBACK_ENABLED=false
HMS_CALLBACK_TURNSTILE_SECRET=

# Optional: automatically initiate policy refunds after patient confirmation. Default requires administrator approval.
HMS_AUTO_POLICY_REFUNDS=false
