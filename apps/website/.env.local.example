# Isolated UI preview; public live mode loads ONLY published database content.
HMS_PUBLIC_LIVE=false
HMS_ALLOW_INDEXING=false
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
HMS_ORGANIZATION_SLUG=
HMS_BRANCH_CODE=MAIN
NEXT_PUBLIC_HOSPITAL_NAME=
NEXT_PUBLIC_HOSPITAL_DESCRIPTION=
NEXT_PUBLIC_HOSPITAL_ADDRESS=
NEXT_PUBLIC_HOSPITAL_PHONE=
NEXT_PUBLIC_HOSPITAL_EMAIL=
NEXT_PUBLIC_HOSPITAL_HOURS=
# E.164 number without + or punctuation (include country code); never use a fake number.
NEXT_PUBLIC_HOSPITAL_WHATSAPP=

# Public callback form only: Turnstile site key. Secret remains on portal server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
